# Project Longshot - Environment Configuration
# ================================================
# Copy this file to .env and fill in your API keys

# API Keys (optional - enables enhanced AI features)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=sqlite:///data/longshot.db

# Logging
LOG_LEVEL=INFO

# Feature Flags
ENABLE_BLOCKCHAIN_LEDGER=false
ENABLE_3D_VISUALIZATION=true
ENABLE_SIMULATION_MODE=true
ENABLE_AI_COUNCIL=true

# Module Settings
DETECTIVE_MAX_RESULTS=5
DETECTIVE_RETRY_ATTEMPTS=3
SEER_SIMULATION_DEPTH=5
COUNCIL_DEBATE_ROUNDS=3
HISTORIAN_MAX_PRECEDENTS=10
